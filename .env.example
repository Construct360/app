# Public browser configuration. These values are intentionally exposed to the frontend.
# Security is enforced by Supabase Auth and Row Level Security, not by hiding these values.
CONSTRUCT360_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
CONSTRUCT360_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
CONSTRUCT360_ADMIN_FUNCTION_NAME=admin-users

# Private server-only weather provider key. Never expose via api/config.js.
WEATHER_API_KEY=YOUR_WEATHERAPI_KEY
